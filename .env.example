# Скопіюйте в .env і замініть значення (.env у git не додається).
# JWT_KEYS: kid:base64, ключ від 32 байтів: openssl rand -base64 32
JWT_KEYS=k1:ЗГЕНЕРУЙТЕ_openssl_rand_-base64_32
JWT_CURRENT=k1
# WEBHOOK_SECRETS: від 32 символів: openssl rand -hex 32
WEBHOOK_SECRETS=ЗГЕНЕРУЙТЕ_openssl_rand_-hex_32
ALLOWED_ORIGINS=http://localhost:8080
LOG_LEVEL=info
