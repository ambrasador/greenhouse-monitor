{
  "name": "greenhouse-monitor",
  "version": "1.0.0",
  "private": true,
  "description": "Застосунок Greenhouse Monitor з розділів 1–6 підручника «Технології розробки додатків для інтернету речей»: приймання телеметрії, REST API, канал даних реального часу (Socket.IO, SSE, MQTT через WebSocket), вебдашборд (React, TanStack Query, Recharts) і захист застосунку (вхід, ролі, підписаний вебхук, журнал аудиту)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "start": "node main.js",
    "build:client": "node client/build.mjs --prod",
    "lint:api": "npx --yes @redocly/cli@2.73.0 lint openapi.yaml",
    "bench": "node bench.js",
    "e2e": "node e2e-main.mjs",
    "e2e:browser": "node e2e-browser.mjs socketio reset",
    "measure:ch3": "bash measure-ch3.sh",
    "demo:dashboard": "node demo-dashboard.js",
    "e2e:dashboard": "node e2e-dashboard.mjs",
    "measure:ch4": "bash measure-ch4.sh",
    "measure:ch5": "bash measure-ch5.sh",
    "measure:ch6": "bash measure-ch6.sh",
    "measure:ch7": "bash measure-ch7.sh",
    "test:jest": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects unit",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects integration",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects e2e",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects unit integration --coverage",
    "lint": "eslint --max-warnings=0 .",
    "test:rules": "docker run --rm -v \"$PWD/ops\":/ops --entrypoint promtool prom/prometheus:v3.16.0 test rules /ops/alerts.test.yml"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mqtt": "^5.16.1",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "protobufjs": "^8.8.1",
    "socket.io": "^4.8.4",
    "ws": "^8.22.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@grpc/grpc-js": "^1.14.7",
    "@grpc/proto-loader": "^0.8.1",
    "@tanstack/react-query": "^5.105.3",
    "aedes": "^1.2.0",
    "aedes-server-factory": "^0.2.1",
    "ajv-formats": "^3.0.1",
    "autocannon": "^8.0.0",
    "chart.js": "^4.6.1",
    "d3-scale": "^4.0.3",
    "d3-shape": "^3.2.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "leaflet": "^1.9.4",
    "playwright": "~1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1"
  }
}
